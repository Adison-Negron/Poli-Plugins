+/* PROG_DYNAMIC (vst.json "defines", with "programs" on a whole-number param): how many programs there are right now is
+ * the engine's answer to "<key>_count" (1..NPROGRAMS). For a plugin whose program list changes while it runs (PoliPlug:
+ * the presets of whichever hosted effect is open). numPrograms is refreshed before every UpdateDisplay, which MPC answers
+ * by re-listing the programs (DISPLAY_REV_NO_UPDATE above). */
+static int prog_count(wrap_t *w) {
+#if defined(PROG_DYNAMIC) && defined(PROG_PARAM)
+    char k2[96], buf[32];
+    snprintf(k2, sizeof k2, "%s_count", PARAMS[PROG_PARAM].key);
+    int n = eng_get(w, k2, buf, sizeof buf) > 0 ? atoi(buf) : NUM_PROGRAMS;
+    return n < 1 ? 1 : n > NUM_PROGRAMS ? NUM_PROGRAMS : n;
+#else
+    (void)w;
+    return NUM_PROGRAMS;
+#endif
+}
